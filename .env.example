# Local development values only. Copy to .env and replace placeholders.
POSTGRES_USER=cloudscale
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=15432

AUTH_DATABASE_URL=jdbc:postgresql://localhost:15432/cloudscale_auth
CONFIG_DATABASE_URL=jdbc:postgresql://localhost:15432/cloudscale_config
ROLLOUT_DATABASE_URL=jdbc:postgresql://localhost:15432/cloudscale_rollout
AUDIT_DATABASE_URL=jdbc:postgresql://localhost:15432/cloudscale_audit

REDIS_HOST=localhost
REDIS_PORT=6379

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

KAFKA_BOOTSTRAP_SERVERS=localhost:29092

JWT_ISSUER=cloudscale-auth
JWT_SECRET=replace-with-a-local-development-secret-at-least-32-characters

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
