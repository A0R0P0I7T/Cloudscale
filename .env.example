# Local development values only. Copy to .env and fill the required values.
POSTGRES_USER=cloudscale
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=15432

AUTH_DATABASE_URL=jdbc:postgresql://localhost:15432/cloudscale_auth
CONFIG_DATABASE_URL=jdbc:postgresql://localhost:15432/cloudscale_config
ROLLOUT_DATABASE_URL=jdbc:postgresql://localhost:15432/cloudscale_rollout
AUDIT_DATABASE_URL=jdbc:postgresql://localhost:15432/cloudscale_audit

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=localhost:29092

JWT_ISSUER=cloudscale-authf
JWT_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200
